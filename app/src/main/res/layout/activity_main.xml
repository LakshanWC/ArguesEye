<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/bg_primary"
    android:fitsSystemWindows="true">

    <!-- Header with logo and title -->
    <LinearLayout
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/nav_bar_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="10dp"
            android:layout_gravity="center_horizontal">

            <ImageButton
                android:id="@+id/btn_home"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="10dp"
                android:src="@drawable/shield_24px"
                app:tint= "@color/nice_blue"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btn_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="10dp"
                android:src="@drawable/more_horiz_24px"
                android:onClick="goToMenu"
                app:tint ="@color/white"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center"
            android:text="Argues Eye"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="30dp"/>
    </LinearLayout>

    <!-- Body -->
    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:background="@color/black"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <!-- Search bar -->
        <LinearLayout
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/bg_card"
            android:padding="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        </LinearLayout>

        <!-- Scrollable content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Risk label -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/tv_risk_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UNKNOWN"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_risk_summery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"/>

                </LinearLayout>


                <TextView
                    android:id="@+id/tv_url_details_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="URL Details"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/text_secondary"/>

<!--keep all domaind details-->
                <LinearLayout
                    android:id="@+id/domain_details_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/nav_button_box"
                    android:padding="16dp"
                    android:layout_margin="12dp"
                    android:elevation="4dp"
                    android:gravity="center_horizontal">

                <!-- Domain info -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Subdomain"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="12dp"/>
                <TextView
                    android:id="@+id/tv_subdomain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:paddingBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Domain"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"/>
                <TextView
                    android:id="@+id/tv_domain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:paddingBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Top-Level Domain"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"/>
                <TextView
                    android:id="@+id/tv_tld"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:paddingBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scheme-(http or https)"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"/>
                <TextView
                    android:id="@+id/tv_scheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:paddingBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Path"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"/>
                <TextView
                    android:id="@+id/tv_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:paddingBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Query Parameters"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"/>
                <TextView
                    android:id="@+id/tv_query"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:paddingBottom="12dp"/>

                </LinearLayout>

<!--    Domain information    -->

                <TextView
                    android:id="@+id/tv_domain_info_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Domain Information"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"/>

                <LinearLayout
                    android:id="@+id/domain_info_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/nav_button_box"
                    android:padding="16dp"
                    android:layout_margin="12dp"
                    android:elevation="4dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Date of Registration"
                        android:textStyle="bold"
                        android:layout_marginTop="15dp"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tv_registration_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"/>


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Expiry Date"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tv_expire_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Last Updated On"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tv_last_changed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"/>

                    <!--    domain age section    -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Domain Age"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tv_domain_age"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="isExpired"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tv_is_expired"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Safety Note"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tv_safety_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"/>

                </LinearLayout>

<!--    redirection chain Information    -->
                <TextView
                    android:visibility="gone"
                    android:id="@+id/tv_redirection_info_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Redirection Chain"
                    android:layout_marginTop="15dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"/>

                <LinearLayout
                    android:id="@+id/redirection_chain_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@drawable/nav_button_box"
                    android:padding="16dp"
                    android:layout_margin="12dp"
                    android:elevation="4dp">

                </LinearLayout>



                <!-- SSL Certificate Info -->
                <TextView
                    android:id="@+id/tv_ssl_certificate_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SSL Certificate Details"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="16dp"/>
                <TextView
                    android:id="@+id/tv_cert_avilability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/ssl_cert_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@drawable/nav_button_box"
                    android:padding="16dp"
                    android:layout_margin="12dp"
                    android:elevation="4dp">

                    <!-- DANGER/WARNING BANNER (shown only if unsafe) -->
                    <LinearLayout
                        android:id="@+id/cert_warning_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#33FF0000"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_cert_security_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CERTIFICATE PROBLEM"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#D00000"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- GREEN "SAFE" BANNER (optional) -->
                    <LinearLayout
                        android:id="@+id/cert_safe_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#3300AA00"
                        android:padding="10dp"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Valid certificate for this domain"
                            android:textColor="#006400"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- Subject -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Subject"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tv_cert_subject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="N/A"
                        android:textColor="@color/text_primary"
                        android:paddingBottom="12dp"/>

                    <!-- Issuer -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Issuer"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tv_cert_issuer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="N/A"
                        android:textColor="@color/text_primary"
                        android:paddingBottom="12dp"/>

                    <!-- Validity -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Valid From"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tv_cert_valid_from"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="N/A"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Valid Until"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tv_cert_valid_until"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="N/A"
                        android:textColor="@color/text_primary"
                        android:paddingBottom="12dp"/>

                    <!-- SHA-256 Fingerprint (copyable) -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SHA-256 Fingerprint"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tv_cert_fingerprint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="N/A"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:background="#11FFFFFF"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:textIsSelectable="true"
                        android:paddingBottom="12dp"/>

                    <!-- Subject Alternative Names -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Valid For (SANs)"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tv_cert_sans"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="None"
                        android:textColor="@color/text_primary"
                        android:paddingStart="8dp"
                        android:paddingBottom="8dp"/>

                </LinearLayout>
<!-- website Image-->
                <TextView
                    android:id="@+id/tv_website_image_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Website Preview"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/website_image_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/iv_website_image"
                        android:layout_marginTop="10dp"
                        android:src="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"/>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>


    <!-- FAB MENU CONTAINER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fab_menu_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/bottom_action_bar_card"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="20dp">

        <!-- Dim overlay -->
        <View
            android:id="@+id/dim_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#80000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Parent FAB btn-->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_fab_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="150dp"
            android:src="@drawable/visibility_ic"
            app:backgroundTint="@color/serenity_blue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

<!--has all the buttons inside the FAB--><LinearLayout
        android:id="@+id/fab_menu_items_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        app:layout_constraintEnd_toEndOf="@id/btn_fab_parent"
        app:layout_constraintBottom_toTopOf="@id/btn_fab_parent">

        <!-- Open Sandbox -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:layout_marginRight="10dp">

            <TextView
                android:id="@+id/tv_fab_open_sandbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open Sandbox"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:paddingEnd="8dp"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_fab_open_sandBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/security_ic"/>
        </LinearLayout>

        <!-- Continue -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:layout_marginLeft="35dp">

            <TextView
                android:id="@+id/tv_fab_continue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continue"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:paddingEnd="8dp"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_fab_continue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/warning_ic"/>
        </LinearLayout>

        <!-- Block -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:layout_marginLeft="55dp">

            <TextView
                android:id="@+id/tv_fab_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Block"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:paddingEnd="8dp"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_fab_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cancel_24px"/>
        </LinearLayout>

    </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>



    <!-- Footer / Bottom Action Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_action_bar_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/bg_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/rounded_input_bg">

            <!-- Input + Verify - always visible -->
            <LinearLayout
                android:id="@+id/input_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/btn_clear_url"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/cancel_24px"
                    app:tint="@color/text_secondary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/editTxt_url"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:hint="Paste or type URL here..."
                    android:background="@null"
                    android:paddingHorizontal="12dp"
                    android:textSize="16sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:inputType="textUri" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_verify"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="100dp"
                    android:text="Verify"
                    android:textSize="15sp"
                    android:paddingHorizontal="24dp"
                    android:backgroundTint="@color/nice_blue" />
            </LinearLayout>

            <!-- Action buttons - appear below input when visible -->
            <LinearLayout
                android:id="@+id/action_btn_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Block + Continue side by side -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_block"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Block"
                        android:textColor="@color/btn_block"
                        app:icon="@drawable/block_ic"
                        app:iconGravity="textStart"
                        app:iconTint="@color/btn_block"
                        app:strokeColor="@color/btn_block" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_continue"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/btn_continue_anyway"
                        android:text="Continue"
                        app:icon="@drawable/warning_ic"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white" />
                </LinearLayout>

                <!-- Sandbox button - full width -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_sandbox"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/btn_sandbox"
